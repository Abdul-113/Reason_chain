# ReasonChain Environment Configuration Example

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# PostgreSQL Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reasonchain_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Neo4j Graph Database Connection Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Firebase Realtime Database Settings (server-side only — NEVER commit credentials)
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=/secure/path/to/service-account.json

# AI-Assisted Semantic Mapping (server-side only — NEVER commit API keys)
AI_PROVIDER=groq
AI_API_KEY=your-api-key-here
AI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
AI_BASE_URL=https://api.groq.com/openai/v1

